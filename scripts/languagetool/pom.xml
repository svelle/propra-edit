<?xml version="1.0" encoding="UTF-8"?>
<!-- Used only by scripts/fetch-runtime.*: resolves the LanguageTool server and the German
     language module from Maven Central (checksums verified with mvn -C). -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>de.svelle.propra-editor</groupId>
  <artifactId>languagetool-runtime</artifactId>
  <version>1</version>
  <packaging>pom</packaging>
  <properties>
    <languagetool.version>6.8</languagetool.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.languagetool</groupId>
      <artifactId>languagetool-server</artifactId>
      <version>${languagetool.version}</version>
    </dependency>
    <dependency>
      <groupId>org.languagetool</groupId>
      <artifactId>language-de</artifactId>
      <version>${languagetool.version}</version>
    </dependency>
  </dependencies>
</project>
